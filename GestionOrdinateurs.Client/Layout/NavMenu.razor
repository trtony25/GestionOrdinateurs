@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">GestionOrdinateurs.Client</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="ordinateurs">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Ordinateurs
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="reparations">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Réparations
            </NavLink>
        </div>
        @if (!estConnecte)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Connexion
                </NavLink>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <span class="nav-link">Connecté : @utilisateur</span>
            </div>
            <div class="nav-item px-3">
                <button class="nav-link btn btn-link" @onclick="Deconnecter">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Déconnexion
                </button>
            </div>
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private bool estConnecte;
    private string utilisateur = string.Empty;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override async Task OnInitializedAsync()
    {
        await ActualiserUtilisateur();
        // Se met à jour quand l'état d'authentification change (connexion / déconnexion)
        AuthProvider.AuthenticationStateChanged += async _ =>
        {
            await ActualiserUtilisateur();
            await InvokeAsync(StateHasChanged);
        };
    }

    // Lit l'identité fournie par Keycloak : nom d'utilisateur et rôle (claim "role" du realm)
    private async Task ActualiserUtilisateur()
    {
        var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
        estConnecte = user.Identity?.IsAuthenticated == true;

        if (estConnecte)
        {
            var nom = user.FindFirst("preferred_username")?.Value ?? user.Identity?.Name;
            var role = string.Join(", ", user.FindAll("role").Select(c => c.Value));
            utilisateur = $"{nom} ({role})";
        }
    }

    // Déconnexion : redirige vers Keycloak pour fermer la session SSO
    private void Deconnecter()
    {
        Navigation.NavigateToLogout("authentication/logout");
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
