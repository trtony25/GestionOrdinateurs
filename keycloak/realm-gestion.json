    }
  ],
  "clients": [
    {
      "clientId": "gestion-client",
      "name": "Client Blazor GestionOrdinateurs",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "rootUrl": "http://localhost:5000",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:5000/*",
        "http://localhost:5200/*"
      ],
      "webOrigins": [
        "http://localhost:5000",
        "http://localhost:5200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5000/*##http://localhost:5200/*"
      },
      "protocolMappers": [
        {
          "name": "role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "role",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}